{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Django Server (Daphne/ASGI)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "--noreload"
            ],
            "django": true,
            "justMyCode": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "chatapp.settings"
            }
        },
        {
            "name": "Run Daphne (WebSocket Support)",
            "type": "python",
            "request": "launch",
            "module": "daphne",
            "args": [
                "-b", "127.0.0.1",
                "-p", "8000",
                "chatapp.asgi:application"
            ],
            "justMyCode": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "chatapp.settings"
            }
        },
        {
            "name": "Django Migrations",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["migrate"],
            "django": true,
            "justMyCode": true
        },
        {
            "name": "Create Superuser",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["createsuperuser"],
            "django": true,
            "justMyCode": true
        }
    ]
}
